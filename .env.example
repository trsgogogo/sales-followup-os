# Copy to .env. Generate your own token; never commit .env.
FOLLOWUP_API_TOKEN=replace-with-a-random-token-at-least-24-chars
SALES_OWNERS=sales-a,sales-b
FIRST_RESPONSE_MINUTES=10
QUOTE_FOLLOWUP_DAYS=3,7,14
MEETING_NEXT_STEP_HOURS=24
FOLLOWUP_DB=data/followup.db

# Optional internal reminder channel: generic | slack | feishu | wecom
NOTIFY_WEBHOOK_URL=
NOTIFY_FORMAT=generic
NOTIFY_WEBHOOK_TOKEN=

# Optional Chat Completions-compatible HTTPS endpoint. Full URL, including path.
LLM_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional reviewed outbound email via SMTP STARTTLS.
ENABLE_EMAIL_SEND=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
